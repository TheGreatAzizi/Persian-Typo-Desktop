<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PersianTypoFixer.App.NoticeWindow"
        Title="هشدار معنایی"
        Width="390"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="{StaticResource AppFont}"
        FlowDirection="RightToLeft">
  <Border Background="#F5141414"
          BorderBrush="#B45309"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 12 34 0 #B3000000"
          ClipToBounds="True">
    <Grid ColumnDefinitions="4,*">
      <Border Background="#F59E0B" />
      <StackPanel Grid.Column="1" Margin="14,12" Spacing="7">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <PathIcon Width="15" Height="15" Foreground="#FBBF24"
                      Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
            <TextBlock Text="هشدار معنایی" Foreground="#FBBF24" FontSize="12" FontWeight="Bold" />
          </StackPanel>
          <Button x:Name="CloseButton"
                  Grid.Column="1"
                  Content="×"
                  Width="24" Height="24"
                  Padding="0"
                  FontSize="18"
                  Foreground="#9CA3AF"
                  Background="Transparent"
                  BorderThickness="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Cursor="Hand"
                  ToolTip.Tip="بستن">
            <Button.Styles>
              <Style Selector="Button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#2A2A2A" />
              </Style>
            </Button.Styles>
          </Button>
        </Grid>
        <TextBlock x:Name="MessageText"
                   Foreground="#F1F1F1"
                   FontSize="12.5"
                   LineHeight="24"
                   TextWrapping="Wrap" />
        <TextBlock Text="Persian Typo Fixer"
                   Foreground="#6B7280"
                   FontSize="10" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
