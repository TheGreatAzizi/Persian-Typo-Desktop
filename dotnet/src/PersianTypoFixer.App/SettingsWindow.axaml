<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PersianTypoFixer.App.SettingsWindow"
        Title="اصلاح‌گر تایپ فارسی"
        Icon="avares://PersianTypoFixer/Assets/icon.png"
        Width="720" Height="820"
        MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F0F"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}">
  <Window.Resources>
    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#2563EB" Offset="0" />
      <GradientStop Color="#1E3A8A" Offset="1" />
    </LinearGradientBrush>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="BorderBrush" Value="#2A2A2A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.optionRow">
      <Setter Property="Background" Value="#111111" />
      <Setter Property="BorderBrush" Value="#242424" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F3F4F6" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F1F1F1" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#9CA3AF" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D4ED8" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1E40AF" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D1D5DB" />
      <Setter Property="BorderBrush" Value="#2A2A2A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F1F1F" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0B0B0B" />
      <Setter Property="BorderBrush" Value="#2A2A2A" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="#F3F4F6" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#3B82F6" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#2563EB" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
    </Style>
    <Style Selector="Border.exampleBad">
      <Setter Property="Background" Value="#3A1D1D" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.exampleGood">
      <Setter Property="Background" Value="#12301F" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="22,20">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="48" Height="48" CornerRadius="13" Background="#33FFFFFF" Padding="8">
          <Image Source="avares://PersianTypoFixer/Assets/icon.png" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="اصلاح‌گر تایپ فارسی" FontSize="19" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="نوشتن روان، درست و بدون وقفه — با هشدارهای معنایی"
                     FontSize="11.5" Foreground="#D6E2FF" />
        </StackPanel>
        <Border Grid.Column="2" Background="#33000000" CornerRadius="999" Padding="11,6"
                VerticalAlignment="Center" MaxWidth="300">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Foreground="#DBEAFE" FontSize="10.5"
                       TextWrapping="Wrap" MaxWidth="270" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="22,18" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Center">

        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Foreground="#60A5FA"
                        Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
              <TextBlock Classes="sectionTitle" Text="تنظیمات عمومی" />
            </StackPanel>
            <StackPanel x:Name="GeneralPanel" Spacing="8" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Foreground="#60A5FA"
                        Data="M20 5H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 2H5v-2h2v2zm0-3H5V8h2v2zm9 7H8v-2h8v2zm0-4h-2v-2h2v2zm0-3h-2V8h2v2zm3 3h-2v-2h2v2zm0-3h-2V8h2v2z" />
              <TextBlock Classes="sectionTitle" Text="میانبر اصلاح سریع" />
            </StackPanel>
            <TextBlock Classes="hint"
                       Text="متن را انتخاب کنید و این ترکیب را بزنید تا اصلاح و جایگذاری شود. برای تغییر، کادر زیر را کلیک کنید و ترکیب دلخواه را فشار دهید." />
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" FlowDirection="LeftToRight"
                     HorizontalAlignment="Left" MinWidth="210" FontSize="14" FontWeight="SemiBold"
                     Foreground="#93C5FD" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Foreground="#FBBF24"
                        Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
              <TextBlock Classes="sectionTitle" Text="هشدار معنایی" />
              <Border Background="#3A2A10" CornerRadius="999" Padding="8,2" Margin="4,0,0,0">
                <TextBlock Text="ویژه" FontSize="10" Foreground="#FBBF24" />
              </Border>
            </StackPanel>
            <TextBlock Classes="hint"
                       Text="برای کلمات دوپهلو مثل «بزار / بذار» فقط هشدار می‌دهد و متن را خودسرانه عوض نمی‌کند؛ چون ممکن است منظور «زار زدن» باشد." />
            <StackPanel x:Name="NoticesPanel" Spacing="8" />
            <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                    CornerRadius="10" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="نمونه‌ها" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" />
                <Grid ColumnDefinitions="Auto,20,Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                  <Border Grid.Row="0" Grid.Column="0" Classes="exampleBad">
                    <TextBlock Text="بزارم" FontSize="11.5" Foreground="#FCA5A5" />
                  </Border>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="←" Foreground="#6B7280"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Row="0" Grid.Column="2" Classes="exampleGood">
                    <TextBlock Text="بذارم" FontSize="11.5" Foreground="#86EFAC" />
                  </Border>
                  <TextBlock Grid.Row="0" Grid.Column="3" Text="گذاشتن (محاوره‌ای)" Classes="hint"
                             Margin="10,0,0,0" VerticalAlignment="Center" />

                  <Border Grid.Row="1" Grid.Column="0" Classes="exampleBad">
                    <TextBlock Text="میزارم" FontSize="11.5" Foreground="#FCA5A5" />
                  </Border>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="←" Foreground="#6B7280"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Row="1" Grid.Column="2" Classes="exampleGood">
                    <TextBlock Text="می‌گذارم" FontSize="11.5" Foreground="#86EFAC" />
                  </Border>
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="گذاشتن (رسمی)" Classes="hint"
                             Margin="10,0,0,0" VerticalAlignment="Center" />

                  <Border Grid.Row="2" Grid.Column="0" Classes="exampleBad">
                    <TextBlock Text="حیات" FontSize="11.5" Foreground="#FCA5A5" />
                  </Border>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="←" Foreground="#6B7280"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Grid.Row="2" Grid.Column="2" Classes="exampleGood">
                    <TextBlock Text="حیاط" FontSize="11.5" Foreground="#86EFAC" />
                  </Border>
                  <TextBlock Grid.Row="2" Grid.Column="3" Text="محوطه خانه" Classes="hint"
                             Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Foreground="#60A5FA"
                        Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              <TextBlock Classes="sectionTitle" Text="قواعد اصلاح" />
            </StackPanel>
            <StackPanel x:Name="RulesPanel" Spacing="8" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Foreground="#60A5FA"
                        Data="M4 17h16v2H4zm0-4h16v2H4zm0-4h16v2H4zm0-4h16v2H4z" />
              <TextBlock Classes="sectionTitle" Text="نشانه‌گذاری و فاصله‌ها" />
            </StackPanel>
            <StackPanel x:Name="PunctuationPanel" Spacing="8" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Foreground="#60A5FA"
                        Data="M5 9h3v6H5zm5.5 0h3v6h-3zM16 9h3v6h-3z" />
              <TextBlock Classes="sectionTitle" Text="اعداد و جداکننده‌ها" />
            </StackPanel>
            <StackPanel x:Name="NumbersPanel" Spacing="8" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Foreground="#60A5FA"
                        Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" />
              <TextBlock Classes="sectionTitle" Text="کلمات سفارشی" />
            </StackPanel>
            <TextBlock Classes="hint" Text="هر خط به شکل «شکل غلط = شکل درست». خطوطی که با # شروع شوند نادیده گرفته می‌شوند." />
            <TextBox x:Name="CustomWordsBox" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="92" FlowDirection="RightToLeft" VerticalContentAlignment="Top" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Width="16" Height="16" Foreground="#60A5FA"
                        Data="M6 2v2h1v3.2L2.5 17.4C1.9 18.7 2.9 20 4.3 20h15.4c1.4 0 2.4-1.3 1.8-2.6L17 7.2V4h1V2H6zm2 2h8v3.3l1.1 2.7H15v2h3.1l1.3 3H4.6l1.3-3H9v-2H6.9L8 7.3V4z" />
              <TextBlock Classes="sectionTitle" Text="آزمایش زنده" />
            </StackPanel>
            <TextBlock Classes="hint" Text="متن نمونه را بنویسید یا جای‌گذاری کنید تا نتیجه و هشدارهای معنایی را همان‌جا ببینید." />
            <TextBox x:Name="TestInputBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                     VerticalContentAlignment="Top" />
            <StackPanel Spacing="6">
              <TextBlock Text="خروجی اصلاح‌شده" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" />
              <Border Background="#0B0B0B" BorderBrush="#242424" BorderThickness="1"
                      CornerRadius="10" Padding="12" MinHeight="46">
                <SelectableTextBlock x:Name="TestResultText" FontSize="13"
                                     Foreground="#BFDBFE" TextWrapping="Wrap" LineHeight="23" />
              </Border>
            </StackPanel>
            <Border x:Name="TestNoticePanel" Background="#2A2110" BorderBrush="#78350F"
                    BorderThickness="1" CornerRadius="10" Padding="12" MinHeight="104">
              <StackPanel Spacing="4">
                <TextBlock x:Name="TestNoticeTitle" Text="هشدار معنایی" FontSize="11"
                           FontWeight="SemiBold" Foreground="#FBBF24" />
                <TextBlock x:Name="TestNoticeText" FontSize="11.5" Foreground="#FDE68A"
                           TextWrapping="Wrap" LineHeight="21" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Height="10" />

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#111111" BorderBrush="#242424"
            BorderThickness="0,1,0,0" Padding="22,13">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock x:Name="VersionText" Foreground="#6B7280" FontSize="11"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="ExitButton" Classes="ghost" Content="خروج" />
          <Button x:Name="CloseButton" Classes="ghost" Content="بستن به سینی" />
          <Button x:Name="SaveButton" Classes="primary" Content="ذخیره تنظیمات" MinWidth="120" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
